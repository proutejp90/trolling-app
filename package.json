{
  "name": "conditions-recommender",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm run tokens && npm run db:migrate && npm run db:seed && npm run build",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "lint": "eslint . && node scripts/lint-design.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "FIXTURES=replay:autumn FIXED_NOW=2026-10-14T14:00:00Z tsx scripts/job-refresh.mts && playwright test --trace off",
    "db:migrate": "tsx scripts/db.mts migrate",
    "db:seed": "tsx scripts/db.mts seed",
    "db:seed:sql": "tsx scripts/seed-sql.mts",
    "db:reset": "tsx scripts/db.mts reset",
    "job:refresh": "tsx scripts/job-refresh.mts"
  },
  "dependencies": {
    "@recommender/engine": "*",
    "lucide-react": "^0.469.0",
    "next": "^16.0.0",
    "pg": "^8.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
